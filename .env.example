# CloudVault Environment Configuration Template

# Database Connection (PostgreSQL standard, fallback to SQLite for local dev if Postgres is stopped)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/cloudvault_db
# For SQLite local testing, use:
# DATABASE_URL=sqlite:///./cloudvault.db

# Application Secret Key
SECRET_KEY=replace-with-your-production-secret-key-32-chars-min

# Environment Mode (development / production)
ENVIRONMENT=development

# Configurable Redundancy Thresholds (0 - 100)
# Similarity >= 90: NEAR DUPLICATE (Rejected)
# Similarity 70 - 89: REVIEW REQUIRED (Flagged for Manual Review)
# Similarity < 70: UNIQUE (Stored)
NEAR_DUPLICATE_THRESHOLD=90.0
REVIEW_THRESHOLD=70.0

# Frontend API URL
VITE_API_URL=http://localhost:8000
